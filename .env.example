# Copiar a .env local (nunca commitear .env con secretos reales).
# En Render: Dashboard → Environment → Add Environment Variable.

# Obligatorias ERP (ver PRODUCCION.md)
DATABASE_URL=
ERP_SESSION_SECRET=
# Llaves M2M separadas (una por propósito; valores distintos, >= 32 caracteres):
BOT_API_KEY=                # X-API-Key de /api/bot/* (bot WhatsApp)
RECAUDOS_API_KEY=           # X-API-Key de /api/recaudos/bot/*
BOT_PDF_PUBLIC_SECRET=      # firma HMAC de URLs temporales de PDF
AGENT_SUPERVISION_KEY=      # ERP -> agente (supervisión WhatsApp)
# "Grok Bot": llave ADICIONAL. Abre /api/bot/*, /api/recaudos/bot/* (con escritura) y /api/grok/* (solo lectura).
# No acepta la llave heredada. NO abre usuarios, permisos, sesiones, llaves ni configuración.
# Generar: python -c "import secrets;print(secrets.token_urlsafe(48))"
GROK_BOT_API_KEY=
# RATE_LIMIT_GROK_PER_MIN=120      (peticiones por minuto de la llave Grok, en total)
# Consultas a la Rama desde Grok (/api/grok/rama/*; usan LEGAL_API_BASE_URL):
# GROK_RAMA_CONCURRENCY=3          (consultas simultáneas a la Rama en /rama/novedades; 1..5)
# GROK_RAMA_TIMEOUT_S=30           (tope por consulta a la Rama, incluye reintentos; 1..120)
# GROK_RAMA_TOTAL_TIMEOUT_S=100    (tope total de /rama/novedades; los no alcanzados salen en "errores")
# Llave compartida HEREDADA: solo durante la transición; se acepta junto a las nuevas.
# Retirar: borrar la variable o poner M2M_LEGACY_KEY_ENABLED=false.

# Opcionales de sesión / límites (valores por defecto entre paréntesis)
# ERP_SESSION_TTL=28800            (segundos; acotado 300..86400)
# RATE_LIMIT_GLOBAL_PER_MIN=600    (peticiones por IP y minuto)
# RATE_LIMIT_API_PER_MIN=240       (endpoints con API key por IP y minuto)
# RATE_LIMIT_LOGIN_PAIR_FAILS=5    (fallos IP+usuario / 15 min); _USER_FAILS=10; _IP_FAILS=20
# ERP_TRUSTED_PROXY_COUNT=0        (proxies de confianza en X-Forwarded-For; 0 = ignorar)
# ERP_ALLOWED_ORIGINS=             (hosts extra permitidos como Origin, CSV)
LIQUIDADOR_API_KEY=
# M2M_LEGACY_KEY_ENABLED=true
PUBLIC_BASE_URL=
# Llave propia para cifrar el refresh token de Drive en la base (>= 32 caracteres, aleatoria).
# Si falta se usa la derivada de ERP_SESSION_SECRET; con ella, rotar la sesión no rompe Drive.
# DRIVE_TOKEN_KEY=

# API legal externa (cliente async external_legal_client.py)
# LEGAL_API_BASE_URL=https://ejemplo.invalid/api/v2  # obligatoria; incluye versión; sin slash final
# LEGAL_API_TIMEOUT_S=20
# LEGAL_API_CONNECT_TIMEOUT_S=20
# LEGAL_API_MAX_ATTEMPTS=3
# LEGAL_API_RETRY_MIN_WAIT_S=0.5
# LEGAL_API_RETRY_MAX_WAIT_S=8
# LEGAL_API_USER_AGENT=  # opcional; default estilo navegador (Mozilla/Chrome)
# LEGAL_API_EXTRA_HEADERS=  # JSON opcional, ej. {"Authorization":"Bearer …"} o {"X-Api-Key":"…"}
# Base = scheme+host[+puerto]+/api/vN. Cliente concatena NumeroRadicacion / Detalle / Actuaciones / Sujetos.
# Si HTML del SPA: probar /api/v2; si sigue, puerto 448 en la base (https://host:448/api/v2). Sin host en código.

# Sync diaria Rama (cron Render → POST /api/v1/cron/sync-rama)
# CRON_SECRET_KEY=  # secreto largo; header X-Cron-Secret debe coincidir
# SYNC_RAMA_SLEEP_S=3  # pausa entre cada llamada LegalAPIClient (rate limit)

# Documentos de actuación (paths relativos a LEGAL_API_BASE_URL; host solo en env)
# LEGAL_API_DOCUMENTOS_PATH_TEMPLATE=/Proceso/DocumentosActuacion/{id_reg_actuacion}
# LEGAL_API_DESCARGA_PATH_TEMPLATE=/Descarga/Documento/{id_reg_documento}

# PDFs de actuaciones — preferir OAuth Drive (A) o disco ERP (B). Auto si hay env.
# Guía: docs/guia-google-drive-expedientes.md (store Project)
#
# Opción A — Google Drive vía OAuth (recomendado; evita SA keys bloqueadas por org):
# Cliente OAuth tipo **Aplicación web** (no Desktop) con redirect:
#   https://gestionlegal.co/herramientas/google-drive/oauth/callback
# GOOGLE_DRIVE_FOLDER_ID=           # ID carpeta en Gmail Drive (nunca hardcodear en código)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=       # opcional si ya conectaste en ERP (queda cifrado en app_settings)
# GOOGLE_OAUTH_REDIRECT_URI=        # opcional; default = PUBLIC_BASE_URL + /herramientas/google-drive/oauth/callback
# GOOGLE_DRIVE_ENABLED=true         # opcional; auto si hay folder+OAuth (pon false para apagar)
# PUBLIC_BASE_URL=https://gestionlegal.co
# Admin: Informes → Conectar Google Drive (sin Python en el PC)
#
# Legacy (solo si tu org permite claves de service account):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
#
# Opción B — disco del ERP (sin Google):
# EXPEDIENTE_DOCS_ENABLED=true
# EXPEDIENTE_DOCS_DIR=              # opcional; default private_pdfs/expedientes

# Supervisión WhatsApp / agente IA (opcional)
# AGENT_SUPERVISION_URL=https://bot-cobranzas-ph.onrender.com
# AGENT_SUPERVISION_KEY: ver llaves M2M arriba (el fallback a LIQUIDADOR_API_KEY es solo transitorio)
# Webhook opcional al devolver una conversación a la IA (Slack/Zapier/n8n)
# SUPERVISION_IA_WEBHOOK_URL=

# Fallback IA para PDF sin texto (Print to PDF / escaneo) en /herramientas/estado-cuenta
# Cascada default (solo usa los que tengan key): gemini → groq → openrouter → deepseek → anthropic
# Claude queda al final. Doc: ia-pool-modelos-gratuitos.md / ia-fallback-pdf-modelo.md
PDF_IA_PROVIDERS=
# ej. gemini,groq,openrouter,deepseek,anthropic
PDF_IA_PROVIDER=
# Override a UN solo proveedor (compat). Preferir PDF_IA_PROVIDERS.
GEMINI_API_KEY=
# Key gratis: https://aistudio.google.com/apikey
GEMINI_MODEL=
# Opcional; default gemini-2.5-flash
GROQ_API_KEY=
# Key gratis: https://console.groq.com/ — visión por imágenes (PDF→JPEG)
GROQ_MODEL=
# Opcional; default qwen/qwen3.8-27b
OPENROUTER_API_KEY=
# Free router: https://openrouter.ai/ — default openrouter/free
OPENROUTER_MODEL=
DEEPSEEK_API_KEY=
# API de pago barata (NO free tier): https://platform.deepseek.com/
DEEPSEEK_MODEL=
# Opcional; default deepseek-flash
ANTHROPIC_API_KEY=
# Último recurso del pool (o PDF_IA_PROVIDER=anthropic)
# 1 = usar IA si no hay texto nativo (default si hay alguna key del pool). 0 = desactivar.
ESTADO_CUENTA_IA_FALLBACK=
# Opcional: override de modelo SOLO si hay un único proveedor en la cascada.
ESTADO_CUENTA_IA_MODEL=
ANTHROPIC_MODEL=
# Opcional: timeout segundos por PDF imagen (default 120)
ESTADO_CUENTA_IA_TIMEOUT_S=
# Opcional: max tokens salida (default 32000; PDFs 6–7 págs. necesitan >8k)
ESTADO_CUENTA_IA_MAX_TOKENS=
# Opcional Anthropic: 1 = forzar tools/tool_choice (solo si el modelo lo soporta).
# Default OFF (JSON por prompt + parse/repair).
ESTADO_CUENTA_IA_USE_TOOLS=
# Opcional: páginas máximas a renderizar para Groq/OpenRouter/DeepSeek (default 12)
PDF_IA_MAX_PAGES=
