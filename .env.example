# Copiar a .env local (nunca commitear .env con secretos reales).
# En Render: Dashboard → Environment → Add Environment Variable.

# Obligatorias ERP (ver PRODUCCION.md)
DATABASE_URL=
ERP_SESSION_SECRET=
LIQUIDADOR_API_KEY=
PUBLIC_BASE_URL=

# Supervisión WhatsApp / agente IA (opcional)
# AGENT_SUPERVISION_URL=https://bot-cobranzas-ph.onrender.com
# AGENT_SUPERVISION_KEY=   # si vacío, usa LIQUIDADOR_API_KEY
# Webhook opcional al devolver una conversación a la IA (Slack/Zapier/n8n)
# SUPERVISION_IA_WEBHOOK_URL=

# Fallback IA para PDF sin texto (Print to PDF / escaneo) en /herramientas/estado-cuenta
# Default: Gemini (gratis generoso). Claude queda opcional.
# Ver docs del store: ia-fallback-pdf-modelo.md
PDF_IA_PROVIDER=
# gemini (default) | anthropic
GEMINI_API_KEY=
# Key gratis en https://aistudio.google.com/apikey — secret en Render
GEMINI_MODEL=
# Opcional; default gemini-2.5-flash
ANTHROPIC_API_KEY=
# Solo si PDF_IA_PROVIDER=anthropic (o sin GEMINI_API_KEY y con esta key)
# 1 = usar IA si no hay texto nativo (default si hay key del proveedor). 0 = desactivar.
ESTADO_CUENTA_IA_FALLBACK=
# Opcional: override de modelo (Gemini o Claude según proveedor).
ESTADO_CUENTA_IA_MODEL=
ANTHROPIC_MODEL=
# Opcional: timeout segundos por PDF imagen (default 120)
ESTADO_CUENTA_IA_TIMEOUT_S=
# Opcional: max tokens salida (default 32000; PDFs 6–7 págs. necesitan >8k)
ESTADO_CUENTA_IA_MAX_TOKENS=
# Opcional Anthropic: 1 = forzar tools/tool_choice (solo si el modelo lo soporta).
# Default OFF (JSON por prompt + parse/repair).
ESTADO_CUENTA_IA_USE_TOOLS=
